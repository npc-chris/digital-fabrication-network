# Server Configuration
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_fabrication_network
# Dedicated URL for seed/clear-seed scripts (recommended to avoid touching production DB)
SEED_DB_URL=postgresql://postgres:postgres@localhost:5432/digital_fabrication_network
# For Neon, use your pooled connection string with SSL enabled:
# DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
# SEED_DB_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional override for SSL handling in scripts/runtime
DB_SSL=false

# Redis (Caching & Pub/Sub)
# Format: redis://HOST:PORT
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth (for Social Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Google Places (for location autocomplete proxy)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Email/SMTP Configuration (Nodemailer)
# Example for Zoho: smtp.zoho.com
# Example for Gmail: smtp.gmail.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password-or-app-password

# File Storage Configuration
# Set USE_S3=true to use AWS S3, otherwise local storage is used
USE_S3=false
LOCAL_UPLOAD_DIR=uploads

# AWS S3 Configuration (Required if USE_S3=true)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=dfn-uploads
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_FORCE_PATH_STYLE=false

# Payment Providers
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=wh_xxx
FLUTTERWAVE_SECRET_KEY=flw_sk_test_xxx
FLUTTERWAVE_WEBHOOK_SECRET=flw_wh_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

