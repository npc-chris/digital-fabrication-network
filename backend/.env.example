# Server Configuration
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / Neon)
# Local: postgresql://postgres:postgres@localhost:5432/digital_fabrication_network
# Neon Serverless PostgreSQL (Pooled connection string with sslmode=require):
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Dedicated URL for seed/clear-seed scripts (use unpooled or pooled Neon URL)
SEED_DB_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# SSL required for Neon (set to true in production)
DB_SSL=true

# Redis (Caching & Pub/Sub / Upstash)
# Local: redis://localhost:6379
# Upstash Redis (Serverless TLS connection string):
REDIS_URL=rediss://default:your-token@your-region.upstash.io:6379

# Authentication (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth (for Social Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# For production (Render): GOOGLE_CALLBACK_URL=https://dfn-backend.onrender.com/api/auth/google/callback

# Google Places (for location autocomplete proxy)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Email/SMTP Configuration (Nodemailer)
# Example for Zoho: smtp.zoho.com
# Example for Gmail: smtp.gmail.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password-or-app-password

# File Storage Configuration (S3 / MinIO)
# Set USE_S3=true to use MinIO or AWS S3, otherwise local storage is used
USE_S3=true
LOCAL_UPLOAD_DIR=uploads

# S3 / MinIO Configuration (Required if USE_S3=true)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-minio-access-key-or-admin
AWS_SECRET_ACCESS_KEY=your-minio-secret-key-or-password
AWS_S3_BUCKET=dfn-uploads
# For MinIO (Local): http://localhost:9000
# For MinIO (Production): https://minio.yourdomain.com
# For DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
AWS_ENDPOINT=http://localhost:9000
# Set to true for MinIO, false for standard AWS S3 / Spaces virtual-hosted style
AWS_FORCE_PATH_STYLE=true

# Payment Providers
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=wh_xxx
FLUTTERWAVE_SECRET_KEY=flw_sk_test_xxx
FLUTTERWAVE_WEBHOOK_SECRET=flw_wh_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

