# Database Configuration
POSTGRES_USER=dfn_user
POSTGRES_PASSWORD=dfn_password_lol
POSTGRES_DB=digital_fabrication_network
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dfn_user:dfn_password@localhost:5432/digital_fabrication_network

# Redis Configuration
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_URL=redis://:redis_password@localhost:6379

# Application Configuration
NODE_ENV=development
PORT=3001

# S3 / MinIO Configuration
USE_S3=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_S3_BUCKET=dfn-uploads
AWS_ENDPOINT=http://localhost:9000
AWS_FORCE_PATH_STYLE=true

# MinIO Root Credentials (used by docker-compose)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
