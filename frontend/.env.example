# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000

# Hygraph Headless CMS Configuration (DFN Blog)
# High-performance Content API endpoint from: Project Settings -> API Access -> Endpoints
HYGRAPH_ENDPOINT=https://api-us-east-1-shared-usea1-02.hygraph.com/v2/YOUR_PROJECT_ID/master
# Optional Permanent Auth Token (if public read permissions are not enabled)
HYGRAPH_TOKEN=
